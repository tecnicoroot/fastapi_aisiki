# ======================= Aplicação =======================
PROJECT_NAME="FastAPI Pro"
ENVIRONMENT=local            # local | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# ======================= Segurança / JWT =======================
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=aae7e1e90ac3429023ce75a0882936ddf18fff6979586d3b5b28d87b2ea529f0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ======================= PostgreSQL =======================
POSTGRES_HOST=localhost       # no docker-compose é sobrescrito para "db"
POSTGRES_PORT=54339
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DB_ECHO=false

# ======================= Redis (filas) =======================
REDIS_HOST=localhost          # no docker-compose é sobrescrito para "redis"
REDIS_PORT=6379
REDIS_DB=0

# ======================= E-mail (SMTP) =======================
# Em dev o Mailpit captura os e-mails: http://localhost:8025
SMTP_HOST=localhost           # no docker-compose é sobrescrito para "mailpit"
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=false
SMTP_SSL=false

# ======================= Seed =======================
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=Admin@12345
